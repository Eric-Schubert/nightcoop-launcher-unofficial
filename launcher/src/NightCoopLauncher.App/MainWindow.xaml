<Window x:Class="NightCoopLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightCoop Launcher"
        Width="1040" Height="660"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="372" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left: identity, status and the one button that matters -->
      <Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
            <GradientStop Color="#171B26" Offset="0" />
            <GradientStop Color="#0E1017" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Canvas IsHitTestVisible="False">
            <Path Fill="{StaticResource AccentBrush}" Opacity="0.07" Data="M220,0 L372,0 L372,210 Z" />
            <Path Fill="{StaticResource InfoBrush}" Opacity="0.05" Data="M290,0 L372,0 L372,330 Z" />
            <Rectangle Width="372" Height="3" Fill="{StaticResource AccentBrush}" />
          </Canvas>

          <Grid Margin="34,58,34,30">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource Label}" Text="UNOFFICIAL LAUNCHER" />
              <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="50" FontWeight="Bold" Margin="-2,2,0,0">
                <Run Text="NIGHT" /><Run Text="COOP" Foreground="{StaticResource AccentBrush}" />
              </TextBlock>
              <TextBlock Foreground="{StaticResource MutedBrush}" Text="Co-op mod for Cyberpunk 2077" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,38,0,0">
              <StackPanel Orientation="Horizontal">
                <Rectangle Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                  <Rectangle.Style>
                    <Style TargetType="Rectangle">
                      <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusKind}" Value="Ok">
                          <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="Attention">
                          <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                          <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Rectangle.Style>
                </Rectangle>
                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                           Text="{Binding StatusTitle}" />
              </StackPanel>
              <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                         LineHeight="19" Text="{Binding StatusDetail}" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,30,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,20">
                <TextBlock Style="{StaticResource Label}" Text="INSTALLED" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding InstalledVersion}" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,20">
                <TextBlock Style="{StaticResource Label}" Text="LATEST" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding LatestVersion}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource Label}" Text="GAME" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding GameSummary}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Style="{StaticResource Label}" Text="PROTOCOL" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding Protocol}" />
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="4">
              <TextBlock Margin="0,0,0,14" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                         LineHeight="18" Text="{Binding ErrorText}"
                         Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
              <StackPanel Margin="0,0,0,14" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Text="{Binding ProgressText}" />
                <ProgressBar Margin="0,7,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
              </StackPanel>
              <Button Style="{StaticResource PrimaryButton}" Content="{Binding PrimaryText}"
                      Command="{Binding PrimaryCommand}" IsDefault="True" />
              <Button Style="{StaticResource LinkButton}" Margin="0,14,0,0" Content="Check for updates again"
                      Command="{Binding RefreshCommand}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- Title bar: the chrome caption spans the window, the buttons sit on top of it -->
      <StackPanel Grid.Column="1" Height="40" VerticalAlignment="Top" HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick" ToolTip="Minimize">
          <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1" />
        </Button>
        <Button Style="{StaticResource TitleBarButton}" Click="OnCloseClick" ToolTip="Close">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1" />
        </Button>
      </StackPanel>

      <!-- Right: what the update brings, save backups, game folder -->
      <TabControl Grid.Column="1" Margin="38,58,38,30">
        <TabItem Header="WHAT'S NEW">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
              <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"
                         TextWrapping="Wrap" Text="{Binding ReleaseTitle}" />
              <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding ReleaseDate}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl ItemsSource="{Binding Notes}" Margin="0,0,16,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,13">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Rectangle Width="5" Height="5" Margin="0,7,13,0" VerticalAlignment="Top"
                                 Fill="{StaticResource AccentBrush}" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" LineHeight="20" Text="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="1" Foreground="{StaticResource MutedBrush}"
                       Text="No release notes to show."
                       Visibility="{Binding HasNoNotes, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Row="2" Style="{StaticResource LinkButton}" Margin="0,16,0,0"
                    Content="All versions on nightcoop.net" Command="{Binding OpenDownloadPageCommand}" />
          </Grid>
        </TabItem>

        <TabItem Header="SAVE BACKUPS">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" Padding="18,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Back up saves before every update" />
                  <TextBlock Margin="0,5,16,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="19"
                             Text="The launcher keeps the three most recent automatic backups. Backups you make yourself are never deleted." />
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                          IsChecked="{Binding BackupSavesBeforeUpdate}" />
              </Grid>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,18">
              <Button Style="{StaticResource GhostButton}" Content="BACK UP NOW" Command="{Binding BackupNowCommand}" />
              <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Content="OPEN FOLDER"
                      Command="{Binding OpenBackupFolderCommand}" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl ItemsSource="{Binding Backups}" Margin="0,0,16,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="16,11" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="90" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{Binding CreatedText}" />
                        <Border Grid.Column="1" VerticalAlignment="Center" Padding="8,3"
                                Background="{StaticResource SurfaceRaisedBrush}">
                          <TextBlock Style="{StaticResource Label}" Text="{Binding KindText}" />
                        </Border>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}" Text="{Binding SizeText}" />
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="18,0,0,0" Padding="12,6"
                                Content="RESTORE" Command="{Binding RestoreCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Foreground="{StaticResource MutedBrush}" Text="No backups yet."
                       Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </TabItem>

        <TabItem Header="GAME">
          <StackPanel>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" Padding="18,16">
              <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="GAME FOLDER" />
                <TextBlock Margin="0,5,0,0" FontSize="14" TextWrapping="Wrap" Text="{Binding GamePath}" />
                <TextBlock Style="{StaticResource Label}" Margin="0,18,0,0" Text="STORE AND VERSION" />
                <TextBlock Margin="0,5,0,0" FontSize="14" Text="{Binding GameSummary}" />
                <Button Style="{StaticResource GhostButton}" Margin="0,20,0,0" HorizontalAlignment="Left"
                        Content="CHANGE FOLDER" Command="{Binding ChooseGameFolderCommand}" />
              </StackPanel>
            </Border>
            <TextBlock Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="19"
                       Text="NightCoop is an unofficial fan modification. This launcher is not affiliated with the NightCoop team or CD PROJEKT RED." />
          </StackPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </Border>
</Window>
