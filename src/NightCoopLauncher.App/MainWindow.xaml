<Window x:Class="NightCoopLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NightCoopLauncher.App.Localization"
        xmlns:views="clr-namespace:NightCoopLauncher.App.Views"
        Title="NightCoop Launcher"
        Icon="Assets/launcher.ico"
        Width="1240" Height="820" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="14"
        UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Border.Style>
      <Style TargetType="Border">
        <Style.Triggers>
          <!-- A maximized window without a system frame hangs over the screen edge by the frame's width. -->
          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
            <Setter Property="Padding" Value="7" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Title bar -->
      <Border Grid.ColumnSpan="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
            <Image Source="Assets/launcher.ico" Width="24" Height="24" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource CondensedFont}"
                       FontWeight="Bold" FontSize="14" Text="{l:T shell.title}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick" Content="&#xE921;" />
            <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Click="OnMaximizeClick" Content="&#xE922;" />
            <Button Style="{StaticResource TitleBarButton}" Click="OnCloseClick" Content="&#xE8BB;" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Sidebar -->
      <Border Grid.Row="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel Margin="14,20,14,18">
          <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MonoLabel}" Margin="4,14,4,0" TextWrapping="Wrap"
                     Text="{Binding Footer}" />

          <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16,14,16,16"
                  Visibility="{Binding HasDiscord, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Style="{StaticResource MonoLabel}" Text="{l:T shell.discord.label}" />
              <TextBlock Margin="0,8,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="17" Text="{Binding DiscordName}"
                         TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse Width="8" Height="8" Fill="{StaticResource OkBrush}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Mono}" Margin="8,0,0,0" Text="{Binding DiscordOnline}" />
                <TextBlock Style="{StaticResource Mono}" Margin="7,0,0,0" Foreground="{StaticResource MutedBrush}"
                           Text="{l:T shell.discord.online}" />
              </StackPanel>
              <Button Style="{StaticResource SecondaryButton}" Margin="0,14,0,0" Content="{l:T shell.discord.join}"
                      Command="{Binding JoinDiscordCommand}" />
            </StackPanel>
          </Border>

          <StackPanel>
            <RadioButton Style="{StaticResource NavButton}" Tag="&#xE768;" Content="{l:T nav.play}"
                         IsChecked="{Binding IsPlayPage}" />
            <Grid>
              <RadioButton Style="{StaticResource NavButton}" Tag="&#xE896;" Content="{l:T nav.updates}"
                           IsChecked="{Binding IsUpdatesPage}" />
              <Border Width="20" Height="20" Margin="0,0,14,6" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Background="{StaticResource AccentBrush}" IsHitTestVisible="False"
                      Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="1" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7B8;" Content="{l:T nav.backups}"
                         IsChecked="{Binding IsBackupsPage}" />
            <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="{l:T nav.settings}"
                         IsChecked="{Binding IsSettingsPage}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Pages -->
      <Grid Grid.Row="1" Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource DangerPanelBrush}" BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="0,0,0,1" Padding="40,13,24,13"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource TitleBarButton}" Width="32" Height="24"
                    Content="&#xE8BB;" ToolTip="{l:T shell.error.dismiss}" Command="{Binding DismissErrorCommand}" />
            <TextBlock Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" Text="&#xE7BA;" />
            <TextBlock Margin="12,0,12,0" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding ErrorText}" />
          </DockPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsPlayPage, Converter={StaticResource BoolToVisibility}}">
          <views:PlayPage DataContext="{Binding Play}" />
        </Grid>
        <Grid Grid.Row="1" Visibility="{Binding IsUpdatesPage, Converter={StaticResource BoolToVisibility}}">
          <views:UpdatesPage DataContext="{Binding Updates}" />
        </Grid>
        <Grid Grid.Row="1" Visibility="{Binding IsBackupsPage, Converter={StaticResource BoolToVisibility}}">
          <views:BackupsPage DataContext="{Binding Backups}" />
        </Grid>
        <Grid Grid.Row="1" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}">
          <views:SettingsPage DataContext="{Binding Settings}" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
