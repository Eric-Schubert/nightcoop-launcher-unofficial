<UserControl x:Class="NightCoopLauncher.App.Views.BackupsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NightCoopLauncher.App.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40,30,40,40">

      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                Command="{Binding CreateCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE710;" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{l:T backups.create}" />
          </StackPanel>
        </Button>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="{l:T backups.title}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{l:T backups.subtitle}" />
        </StackPanel>
      </DockPanel>

      <!-- Storage -->
      <Border Style="{StaticResource Card}" Margin="0,24,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="3*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource MonoLabel}" Text="{l:T backups.storage.label}" />
            <TextBlock Style="{StaticResource Mono}" Margin="0,10,0,0" FontSize="16" Text="{Binding Summary}" />
            <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Style="{StaticResource MonoLabel}" Text="{Binding ProgressText}" />
              <ProgressBar Margin="0,7,0,0" Value="{Binding ProgressPercent, Mode=OneWay}" />
            </StackPanel>
          </StackPanel>
          <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource SecondaryButton}" Content="{l:T backups.location.open}"
                      Command="{Binding OpenFolderCommand}" />
              <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{l:T backups.location.change}"
                      Command="{Binding ChangeLocationCommand}" />
            </StackPanel>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Style="{StaticResource MonoLabel}" Text="{l:T backups.location.label}" />
              <TextBlock Style="{StaticResource Mono}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding Location}" />
            </StackPanel>
          </DockPanel>
        </Grid>
      </Border>

      <Grid Margin="0,22,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- List -->
        <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
          <StackPanel>
            <ListBox Style="{StaticResource Segmented}" Margin="20,20,20,18" ItemsSource="{Binding Filters}"
                     DisplayMemberPath="Text" SelectedItem="{Binding SelectedFilter}" />

            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <ItemsPresenter />
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Cursor" Value="Hand" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0">
                          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,16,22,16">
                            <ContentPresenter />
                          </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Width="84" TextAlignment="Right"
                               VerticalAlignment="Center" Text="{Binding SizeText}" />
                    <Border x:Name="KindChip" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="10,5"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                      <TextBlock x:Name="KindLabel" FontFamily="{StaticResource CondensedFont}" FontWeight="Bold" FontSize="12"
                                 Text="{Binding KindText}" />
                    </Border>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                      <TextBlock Style="{StaticResource MonoLabel}" Margin="0,5,0,0" FontSize="12.5" Text="{Binding Meta}" />
                    </StackPanel>
                  </DockPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsUpdateKind}" Value="True">
                      <Setter TargetName="KindChip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                      <Setter TargetName="KindLabel" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,22"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Style="{StaticResource Muted}" Text="{l:T backups.empty}" />
            </Border>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2">
          <!-- Selection -->
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                  Padding="24,22,24,24">
            <StackPanel>
              <TextBlock Style="{StaticResource MonoLabel}" Foreground="{StaticResource AccentBrush}"
                         Text="{l:T backups.selected.label}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{l:T backups.selected.none}"
                         Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}" />
              <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="0,12,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="21" TextWrapping="Wrap"
                           Text="{Binding Selected.Title}" />
                <TextBlock Style="{StaticResource MonoLabel}" Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap">
                  <Run Text="{Binding Selected.Meta, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Selected.SizeText, Mode=OneWay}" />
                </TextBlock>
                <Button Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" Content="{l:T backups.restore}"
                        Command="{Binding RestoreCommand}" />
                <UniformGrid Columns="2" Margin="-4,10,-4,0">
                  <Button Style="{StaticResource SecondaryButton}" Margin="4,0" Padding="8,12" Content="{l:T backups.export}"
                          Command="{Binding ExportCommand}" />
                  <Button Style="{StaticResource DangerButton}" Margin="4,0" Padding="8,12" Content="{l:T backups.delete}"
                          Command="{Binding DeleteCommand}" />
                </UniformGrid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Automation -->
          <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="24,22,24,24">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T backups.auto.title}" />
              <DockPanel Margin="0,18,0,0">
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding BackupSavesBeforeLaunch}" />
                <TextBlock FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" Text="{l:T backups.auto.launch}" />
              </DockPanel>
              <Border Style="{StaticResource Divider}" Margin="0,14" />
              <DockPanel>
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding BackupSavesBeforeUpdate}" />
                <TextBlock FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" Text="{l:T backups.auto.update}" />
              </DockPanel>
              <Border Style="{StaticResource Divider}" Margin="0,14" />
              <TextBlock FontSize="15" Text="{l:T backups.auto.keep}" />
              <ListBox Style="{StaticResource Segmented}" Margin="0,10,0,0" ItemsSource="{Binding RetentionOptions}"
                       DisplayMemberPath="Text" SelectedItem="{Binding SelectedRetention}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,0" FontSize="13" LineHeight="19"
                         Text="{l:T backups.auto.note}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
