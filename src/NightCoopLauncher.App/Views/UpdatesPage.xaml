<UserControl x:Class="NightCoopLauncher.App.Views.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NightCoopLauncher.App.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40,30,40,40">

      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"
                Command="{Binding CheckCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE72C;" />
            <TextBlock Margin="10,0,0,0" Text="{l:T updates.check}" />
          </StackPanel>
        </Button>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="{l:T updates.title}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{Binding Subtitle}" />
        </StackPanel>
      </DockPanel>

      <!-- The update itself -->
      <Border Style="{StaticResource KindBorder}" Tag="{Binding CardKind}" Background="{StaticResource PanelBrush}"
              Margin="0,24,0,0" Padding="32,28,32,30">
        <StackPanel>
          <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" Style="{StaticResource KindText}"
                     Tag="{Binding CardKind}" Text="{Binding CardLabel}" />

          <DockPanel Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="60" MinWidth="300"
                    VerticalAlignment="Center" Content="{Binding UpdateButtonText}" Command="{Binding UpdateCommand}"
                    Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="34" Foreground="{StaticResource MutedBrush}"
                         Text="{Binding FromVersion}" />
              <TextBlock Style="{StaticResource Icon}" Margin="18,4,18,0" FontSize="18" Foreground="{StaticResource AccentBrush}"
                         Text="&#xE72A;" Visibility="{Binding ShowArrow, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="34" Text="{Binding ToVersion}" />
            </StackPanel>
          </DockPanel>

          <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{Binding Meta}" />

          <StackPanel Margin="0,24,0,0" Visibility="{Binding ShowSteps, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding ProgressPercentText}" />
              <TextBlock Style="{StaticResource Mono}" Text="{Binding ProgressLabel}" />
            </DockPanel>
            <ProgressBar Margin="0,10,0,0" Height="8" Value="{Binding ProgressPercent, Mode=OneWay}" />

            <ItemsControl Margin="-6,22,-6,0" ItemsSource="{Binding Steps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="Tile" Margin="6,0" Padding="16,15,14,17" Background="{StaticResource BackgroundBrush}"
                          BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                      <TextBlock x:Name="State" Style="{StaticResource MonoLabel}" FontSize="11">
                        <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StateText, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Margin="0,9,0,0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" LineHeight="18"
                                 Text="{Binding Detail}" />
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Active">
                      <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                      <Setter TargetName="State" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Done">
                      <Setter TargetName="State" Property="Foreground" Value="{StaticResource OkBrush}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
              <TextBlock Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top"
                         Margin="0,2,0,0" Text="&#xEA18;" />
              <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" MaxWidth="780" Text="{l:T updates.safety}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Release notes and options -->
      <Grid Margin="0,22,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{Binding NotesTitle}" />
            <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Margin="0,16,0,0"
                    Content="{l:T updates.notes.link}" Command="{Binding OpenPatchNotesCommand}" />
            <Grid Margin="0,18,0,0">
              <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,0,14,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,11">
                        <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Margin="2,8,12,0" VerticalAlignment="Top"
                                 Fill="{StaticResource MutedBrush}" />
                        <TextBlock TextWrapping="Wrap" LineHeight="21" Text="{Binding}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Style="{StaticResource Muted}" Text="{l:T updates.notes.empty}"
                         Visibility="{Binding HasNoNotes, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T updates.auto.title}" />
            <DockPanel Margin="0,20,0,0">
              <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding AutoInstallUpdates}" />
              <StackPanel Margin="0,0,16,0">
                <TextBlock FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Text="{l:T updates.auto.install.title}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" FontSize="13" Text="{l:T updates.auto.install.detail}" />
              </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Divider}" Margin="0,16" />
            <DockPanel>
              <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding BackupSavesBeforeUpdate}" />
              <StackPanel Margin="0,0,16,0">
                <TextBlock FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Text="{l:T updates.auto.backup.title}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" FontSize="13" Text="{l:T updates.auto.backup.detail}" />
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Version history -->
      <Border Style="{StaticResource Card}" Margin="0,22,0,0"
              Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T updates.history.title}" />
          <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding History}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,13" MinHeight="64">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                            Content="{Binding ActionText}" Command="{Binding InstallCommand}" CommandParameter="{Binding}"
                            Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontFamily="{StaticResource CondensedFont}"
                               FontWeight="Bold" FontSize="13" Foreground="{StaticResource OkBrush}" Text="{Binding ActiveText}"
                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource Mono}" Width="170" FontSize="15" VerticalAlignment="Center"
                               Text="{Binding Version}" />
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="{Binding Status}" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
