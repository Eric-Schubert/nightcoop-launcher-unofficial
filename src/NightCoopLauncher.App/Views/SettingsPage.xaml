<UserControl x:Class="NightCoopLauncher.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NightCoopLauncher.App.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40,30,40,40" MaxWidth="860" HorizontalAlignment="Left">

      <TextBlock Style="{StaticResource PageTitle}" Text="{l:T settings.title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{l:T settings.subtitle}" />

      <Border Style="{StaticResource Card}" Margin="0,24,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource MonoLabel}" Text="{l:T settings.language.label}" />
          <ListBox Style="{StaticResource Segmented}" Margin="0,12,0,0" ItemsSource="{Binding Languages}"
                   DisplayMemberPath="Name" SelectedItem="{Binding SelectedLanguage}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,22,0,0">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top"
                  Content="{l:T settings.game.change}" Command="{Binding ChangeGameFolderCommand}" />
          <StackPanel Margin="0,0,24,0">
            <TextBlock Style="{StaticResource MonoLabel}" Text="{l:T settings.game.label}" />
            <TextBlock Style="{StaticResource Mono}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding GamePath}" />
            <TextBlock Style="{StaticResource MonoLabel}" Margin="0,20,0,0" Text="{l:T settings.game.store}" />
            <TextBlock Style="{StaticResource Mono}" Margin="0,10,0,0" Text="{Binding GameSummary}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,22,0,0">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top"
                  Content="{l:T settings.game.change}" Command="{Binding ChangeBackupLocationCommand}" />
          <StackPanel Margin="0,0,24,0">
            <TextBlock Style="{StaticResource MonoLabel}" Text="{l:T settings.backup.label}" />
            <TextBlock Style="{StaticResource Mono}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding BackupLocation}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,22,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource MonoLabel}" Text="{l:T settings.about.label}" />
          <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" FontSize="15" Text="{Binding VersionText}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="{l:T settings.about.text}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
